<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistant_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding_horizontal"
    android:paddingEnd="@dimen/dialog_padding_horizontal"
    android:paddingBottom="@dimen/dialog_padding_vertical">

    <View
        android:id="@+id/assistant_sheet_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:id="@+id/assistant_sheet_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/assistant_sheet_close"
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:contentDescription="@string/cancel"
            android:padding="12dp"
            android:src="@drawable/ic_close_white_24dp"
            android:tint="@color/primary_text" />

        <TextView
            android:id="@+id/assistant_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/assistant_sheet_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Title" />

        <ImageButton
            android:id="@+id/assistant_sheet_options"
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:contentDescription="@string/assistant_sheet_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_horiz_white_24dp"
            android:tint="@color/primary_text" />

        <ImageButton
            android:id="@+id/assistant_sheet_clear_chat"
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:contentDescription="@string/assistant_sheet_action_clear_chat"
            android:padding="12dp"
            android:src="@drawable/ic_delete_white_24dp"
            android:tint="@color/primary_text" />

        <ImageButton
            android:id="@+id/assistant_sheet_expand_toggle"
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:contentDescription="@string/menu_fullscreen"
            android:padding="12dp"
            android:src="@drawable/ic_expand_less_white_24dp"
            android:tint="@color/primary_text" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/assistant_sheet_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/assistant_sheet_mode_ask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/assistant_sheet_mode_ask" />

        <RadioButton
            android:id="@+id/assistant_sheet_mode_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_mode_summary" />

        <RadioButton
            android:id="@+id/assistant_sheet_mode_read_aloud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_mode_read_aloud" />
    </RadioGroup>

    <RadioGroup
        android:id="@+id/assistant_sheet_scope_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/assistant_sheet_scope_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_scope_selection" />

        <RadioButton
            android:id="@+id/assistant_sheet_scope_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_scope_this_page" />

        <RadioButton
            android:id="@+id/assistant_sheet_scope_toc_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_scope_toc_section"
            android:visibility="gone" />

        <RadioButton
            android:id="@+id/assistant_sheet_scope_document"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_scope_whole_document" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/assistant_sheet_provider_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/assistant_sheet_provider_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/assistant_sheet_provider_unconfigured"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

        <Button
            android:id="@+id/assistant_sheet_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_sheet_preview_text" />

        <Button
            android:id="@+id/assistant_sheet_setup_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/assistant_sheet_setup_provider" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/assistant_sheet_content_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Ask -->
        <LinearLayout
            android:id="@+id/assistant_sheet_ask_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/assistant_sheet_chat_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/assistant_sheet_chat_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <HorizontalScrollView
                android:id="@+id/assistant_sheet_attachments_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/assistant_sheet_attachments_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/assistant_sheet_prompt_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/assistant_sheet_attach"
                    style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
                    android:contentDescription="@string/assistant_sheet_attach_docs"
                    android:padding="12dp"
                    android:src="@drawable/ic_add_white_24dp"
                    android:tint="@color/primary_text" />

                <ImageButton
                    android:id="@+id/assistant_sheet_mic"
                    style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
                    android:contentDescription="@string/assistant_sheet_voice_prompt"
                    android:padding="12dp"
                    android:src="@drawable/ic_mic_white_24dp"
                    android:tint="@color/primary_text" />

                <EditText
                    android:id="@+id/assistant_sheet_prompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/assistant_sheet_prompt_hint"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="4" />

                <Button
                    android:id="@+id/assistant_sheet_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/assistant_sheet_send" />
            </LinearLayout>
        </LinearLayout>

        <!-- Summary -->
        <LinearLayout
            android:id="@+id/assistant_sheet_summary_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/assistant_sheet_summary_style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/assistant_sheet_summary_style_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/assistant_sheet_summary_short" />

                <RadioButton
                    android:id="@+id/assistant_sheet_summary_style_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_sheet_summary_medium" />

                <RadioButton
                    android:id="@+id/assistant_sheet_summary_style_detailed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_sheet_summary_detailed" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/assistant_sheet_summary_generate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_sheet_generate" />

                <TextView
                    android:id="@+id/assistant_sheet_summary_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/assistant_sheet_summary_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/assistant_sheet_summary_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textIsSelectable="true" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/assistant_sheet_summary_insert_into_document"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_sheet_insert_into_document" />

                <Button
                    android:id="@+id/assistant_sheet_summary_export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/assistant_sheet_export" />

                <Button
                    android:id="@+id/assistant_sheet_summary_save_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/assistant_sheet_save_note" />

                <Button
                    android:id="@+id/assistant_sheet_summary_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/assistant_sheet_copy" />
            </LinearLayout>
        </LinearLayout>

        <!-- Read aloud -->
        <LinearLayout
            android:id="@+id/assistant_sheet_read_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/assistant_sheet_read_aloud_placeholder"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

            <Button
                android:id="@+id/assistant_sheet_read_aloud_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/assistant_sheet_read_aloud_start" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
