<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/assistant_provider_edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/assistant_provider_name_hint"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/assistant_provider_edit_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/assistant_provider_base_url_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/assistant_provider_edit_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/assistant_provider_model_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/assistant_provider_edit_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/assistant_provider_api_key_hint"
            android:inputType="textPassword" />
    </LinearLayout>
</ScrollView>

