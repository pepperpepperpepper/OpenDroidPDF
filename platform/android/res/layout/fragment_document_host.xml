<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/document_host_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">

    <!-- Acrobat-style "Find in document" bar (search) that works even when the top toolbar is hidden. -->
    <LinearLayout
        android:id="@+id/find_in_document_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/toolbar"
        android:elevation="@dimen/toolbar_elevation"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageButton
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:id="@+id/find_in_document_close"
            android:contentDescription="@string/find_in_document_close"
            android:src="@drawable/ic_close_white_24dp" />

        <EditText
            android:id="@+id/find_in_document_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/menu_find_in_document"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/primary_text_toolbar"
            android:textColorHint="@color/hint_text_toolbar" />

        <ImageButton
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:id="@+id/find_in_document_clear"
            android:contentDescription="@string/find_in_document_clear"
            android:src="@drawable/ic_close_white_24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/find_in_document_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minEms="4"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="0 / 0"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="@color/primary_text_toolbar" />

        <ImageButton
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:id="@+id/find_in_document_prev"
            android:contentDescription="@string/menu_previous"
            android:src="@drawable/ic_action_previous_item" />

        <ImageButton
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:id="@+id/find_in_document_next"
            android:contentDescription="@string/menu_next"
            android:src="@drawable/ic_action_next_item" />

        <ProgressBar
            android:id="@+id/find_in_document_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <ImageButton
            style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
            android:id="@+id/find_in_document_stop"
            android:contentDescription="@string/find_in_document_stop"
            android:src="@drawable/ic_stop_white_24dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/document_host_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/find_in_document_bar"
        android:layout_above="@id/reader_bottom_bar_container"
        android:animateLayoutChanges="false" />

    <LinearLayout
        android:id="@+id/page_scrubber_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_above="@id/reader_bottom_bar_container"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_page_indicator_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/page_scrub_preview"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/page_scrub_preview"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text=""
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/white" />

        <SeekBar
            android:id="@+id/page_scrubber"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="360dp"
            android:minWidth="220dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/page_scrubber_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_page_scrubber_tab"
        android:clickable="true"
        android:contentDescription="@string/page_scrubber_tab"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text=""
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Invisible driver SeekBar used to reuse existing scrubber binding logic for the edge tab. -->
    <SeekBar
        android:id="@+id/page_scrubber_tab_driver"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/navigation_menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/reader_bottom_bar_container"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_page_indicator_pill"
        android:clickable="true"
        android:contentDescription="@string/navigation_menu_button"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_navigation_menu_white_24dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/reader_bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:animateLayoutChanges="false">

        <LinearLayout
            android:id="@+id/reader_quick_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/quick_action_comments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_comments"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mode_comment_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_comments"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_highlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_highlight"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_format_highlight_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_highlight"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_draw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_draw"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mode_edit_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_draw"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_add_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_add_text_annot"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_text_tool_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_add_text_annot"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_fill_sign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_fill_sign"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fill_sign_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_fill_sign"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_more_tools"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_more_tools"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_more_horiz_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_more_tools"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reader_read_aloud_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/read_aloud_action_play_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/read_aloud_play_pause"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/read_aloud_action_play_pause_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_arrow_white_24dp" />

                <TextView
                    android:id="@+id/read_aloud_action_play_pause_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/read_aloud_play"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/read_aloud_action_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/read_aloud_stop"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stop_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/read_aloud_stop"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reader_selection_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selection_action_highlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_highlight"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_format_highlight_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_highlight"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_underline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_underline"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_format_underlined_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_underline"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_strikeout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_strikeout"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_format_strikethrough_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_strikeout"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_copytext"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_content_copy_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_copytext"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_explain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_explain"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_explain_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_explain"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_summarize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_summarize"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_summarize_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_summarize"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selection_action_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_accept"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_done_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/menu_accept"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/primary_text_toolbar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reader_annot_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/annot_action_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/menu_cancel"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clear_white_24dp" />

                <TextView
                    android:layout_width="wrap_content"
