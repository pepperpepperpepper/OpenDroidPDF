<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistant_provider_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <RadioButton
        android:id="@+id/assistant_provider_default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/assistant_provider_default_label" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/assistant_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

        <TextView
            android:id="@+id/assistant_provider_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/assistant_provider_edit"
        style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
        android:contentDescription="@string/assistant_provider_edit"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/primary_text" />

    <ImageButton
        android:id="@+id/assistant_provider_delete"
        style="@style/Widget.OpenDroidPDF.Toolbar.IconButton"
        android:contentDescription="@string/assistant_provider_delete"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/primary_text" />
</LinearLayout>
