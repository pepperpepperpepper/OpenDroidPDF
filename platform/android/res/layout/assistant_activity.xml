<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	     xmlns:app="http://schemas.android.com/apk/res-auto"
	     android:id="@+id/main_layout"
	     android:layout_width="match_parent"
	     android:layout_height="match_parent">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:fillViewport="true"
     android:paddingTop="?attr/actionBarSize"
     android:clipToPadding="false">
    <LinearLayout
       android:id="@+id/sub_layout"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:padding="16dp">

      <TextView
         android:id="@+id/assistant_status"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/assistant_voice_status_idle" />

      <Button
         android:id="@+id/assistant_record_button"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:text="@string/assistant_voice_record" />

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:text="@string/assistant_voice_context_title"
         android:textStyle="bold" />

      <TextView
         android:id="@+id/assistant_context_summary"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:text="" />

      <TextView
         android:id="@+id/assistant_context_text"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:textIsSelectable="true"
         android:text="" />

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:text="@string/assistant_voice_transcript_title"
         android:textStyle="bold" />

      <TextView
         android:id="@+id/assistant_transcript"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:textIsSelectable="true"
         android:text="" />
    </LinearLayout>
  </ScrollView>

  <androidx.appcompat.widget.Toolbar
     android:id="@+id/toolbar"
     style="@style/Widget.OpenDroidPDF.Toolbar.Fixed"/>
</FrameLayout>
