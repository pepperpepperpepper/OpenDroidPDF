# Copy to env.local (or export in your shell) before running.
#
# LiveKit
export LIVEKIT_URL="wss://<your-livekit-host>"
export LIVEKIT_API_KEY="<livekit-api-key>"
export LIVEKIT_API_SECRET="<livekit-api-secret>"

# Cartesia (STT + TTS)
export CARTESIA_API_KEY="<cartesia-api-key>"
# Optional voice/runtime overrides
# export ODP_CARTESIA_STT_MODEL="ink-whisper"
# export ODP_CARTESIA_STT_LANGUAGE="en"
# export ODP_CARTESIA_TTS_MODEL="sonic-2"
# export ODP_CARTESIA_TTS_LANGUAGE="en"
# export ODP_CARTESIA_TTS_VOICE="<voice-id>"
# export ODP_CARTESIA_TTS_SPEED="1.0"

# LLM (OpenAI-compatible)
# Prefer these app-specific vars; OPENAI_API_KEY is also supported by the worker.
export ODP_LLM_API_KEY="<llm-api-key>"
# export ODP_LLM_BASE_URL="https://api.openai.com/v1"
# export ODP_LLM_MODEL="gpt-4.1"

# Optional storage path for ingested document contexts
# export ODP_ASSISTANT_DATA_DIR="$PWD/.data"
