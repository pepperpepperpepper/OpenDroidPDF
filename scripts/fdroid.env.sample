# OpenDroidPDF build/deploy configuration (sample)
# Copy to scripts/fdroid.env and fill in real paths/secrets before running
# scripts/fdroid_build.sh or scripts/fdroid_deploy.sh.

# Build outputs
export ODP_BUILD_DIR="/mnt/subtitled/opendroidpdf-android-build"
export ODP_ABI="arm64-v8a,armeabi-v7a"

# Optional overrides for Gradle
# export ODP_VERSION_CODE=101
# export ODP_VERSION_NAME="1.3.40"

# Optional build resource tuning (recommended for laptop/dev boxes)
# export ODP_FDROID_CLEAN=0               # set to 1 for a full clean rebuild
# export ODP_FDROID_SKIP_INDEX=0          # set to 1 to skip `fdroid update`
# export ODP_FDROID_GRADLE_MAX_WORKERS=2  # lower = less CPU/memory, slower builds
# export ODP_FDROID_GRADLE_XMX=4g         # Gradle JVM heap (used with --no-daemon)
# export ODP_FDROID_GRADLE_METASPACE=512m
# export ODP_FDROID_NDK_JOBS=2            # ndk-build -j (limits native parallelism)
# export ODP_FDROID_KOTLIN_DAEMON_XMX=2g  # KotlinCompileDaemon heap
# export ODP_FDROID_KOTLIN_DAEMON_JVMARGS="-Xmx2g -XX:MaxMetaspaceSize=512m -XX:ReservedCodeCacheSize=320m"
# export ODP_FDROID_BUILD_NICE=10         # lower priority CPU scheduling
# export ODP_FDROID_BUILD_IONICE_CLASS=2  # best-effort IO class
# export ODP_FDROID_BUILD_IONICE_LEVEL=7  # lowest IO priority within class
# export ODP_FDROID_STOP_DAEMONS=1        # run `./gradlew --stop` before building
# export ODP_FDROID_STOP_KOTLIN_DAEMONS=1 # pkill KotlinCompileDaemon before/after build

# Signing (must match the key already used on devices)
export ODP_KEYSTORE="$HOME/fdroid/release.keystore"
export ODP_KEY_ALIAS="uh-oh-fdroid"
export ODP_KEY_PASS="changeit"
# Optional: if your key password differs from your keystore password.
# export ODP_KEY_KEY_PASS="changeit"

# F-Droid repo staging
export ODP_REPO_DIR="$HOME/fdroid/repo"

# Hosting (used by deploy script; optional if you only stage locally)
export ODP_S3_BUCKET="s3://fdroid-uh-oh-wtf"
export ODP_CF_DIST_MAIN="E1234567890ABC"
export ODP_CF_DIST_ALIAS=""  # leave blank if none
